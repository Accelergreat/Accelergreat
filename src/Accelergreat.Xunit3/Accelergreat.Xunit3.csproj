<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
    <PackageId>Accelergreat.Xunit3</PackageId>
    <PackageDescription>Accelergreat xunit v3 testing tools. Accelergreat is an integration testing package that helps to simplify and speed up the writing of integration tests, as well as taking away the challenging task of managing external dependencies.</PackageDescription>
    <PackageTags>Integration;Testing;IntegrationTesting;xunit;xunit3;Accelergreat</PackageTags>
    <DefineConstants>$(DefineConstants);XUNIT3</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.Extensions.Logging" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" />
    <PackageReference Include="xunit.v3.extensibility.core" />
    <PackageReference Include="xunit.v3.runner.utility" />
  </ItemGroup>

  <ItemGroup>
    <None Include="Accelergreat.Xunit3.targets" Pack="true" PackagePath="build" Visible="false" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Accelergreat\Accelergreat.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\Accelergreat.Xunit\AccelergreatBuilder.cs" Link="AccelergreatBuilder.cs" />
    <Compile Include="..\Accelergreat.Xunit\AccelergreatXunitTest.cs" Link="AccelergreatXunitTest.cs" />
    <Compile Include="..\Accelergreat.Xunit\AccelergreatXunitTest.Xunit3.cs" Link="AccelergreatXunitTest.Xunit3.cs" />
    <Compile Include="..\Accelergreat.Xunit\AssemblyInfo.cs" Link="AssemblyInfo.cs" />
    <Compile Include="..\Accelergreat.Xunit\IAccelergreatBuilder.cs" Link="IAccelergreatBuilder.cs" />
    <Compile Include="..\Accelergreat.Xunit\IAccelergreatInitialize.cs" Link="IAccelergreatInitialize.cs" />
    <Compile Include="..\Accelergreat.Xunit\IAccelergreatStartup.cs" Link="IAccelergreatStartup.cs" />
    <Compile Include="..\Accelergreat.Xunit\Extensions\ServiceCollectionExtensions.cs" Link="Extensions\ServiceCollectionExtensions.cs" />
  </ItemGroup>

</Project>
